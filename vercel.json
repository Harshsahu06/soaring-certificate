{
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    },
    "backend": {
      "root": "backend",
      "framework": "express",
      "entrypoint": "server.js"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/((?!api).*).html",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/((?!api).*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}